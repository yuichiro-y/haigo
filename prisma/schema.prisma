// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String   @id @default(uuid()) @db.Uuid
  email          String   @unique
  supabaseUserId String   @unique @map("supabase_user_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  deliveryTypes  DeliveryType[]
  dailyRecords   DailyRecord[]
  monthlyGoals   MonthlyGoal[]

  @@map("users")
}

model DeliveryType {
  id               String   @id @default(uuid()) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  name             String
  currentUnitPrice Int      @map("current_unit_price")
  sortOrder        Int      @map("sort_order")
  isActive         Boolean  @default(true) @map("is_active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  user             User @relation(fields: [userId], references: [id])

  dailyRecordItems DailyRecordItem[]

  @@unique([userId, name])
  @@map("delivery_types")
}

model DailyRecord {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  workDate  DateTime @map("work_date") @db.Date
  memo      String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user      User @relation(fields: [userId], references: [id])

  dailyRecordItems DailyRecordItem[]
  customRevenues   CustomRevenue[]

  @@unique([userId, workDate])
  @@map("daily_records")
}

model DailyRecordItem {
  id                String   @id @default(uuid()) @db.Uuid
  dailyRecordId     String   @map("daily_record_id") @db.Uuid
  deliveryTypeId    String   @map("delivery_type_id") @db.Uuid
  quantity          Int
  nameSnapshot      String   @map("name_snapshot")
  unitPriceSnapshot Int      @map("unit_price_snapshot")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  deliveryType      DeliveryType @relation(fields: [deliveryTypeId], references: [id], onDelete: Restrict)
  dailyRecord       DailyRecord  @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)

  @@unique([dailyRecordId, deliveryTypeId])
  @@map("daily_record_items")
}

model CustomRevenue {
  id            String   @id @default(uuid()) @db.Uuid
  dailyRecordId String   @map("daily_record_id") @db.Uuid
  name          String
  amount        Int
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  dailyRecord   DailyRecord @relation(fields: [dailyRecordId], references: [id], onDelete: Cascade)

  @@map("custom_revenues")
}

model MonthlyGoal {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  targetMonth  DateTime @map("target_month") @db.Date
  targetAmount Int      @map("target_amount")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user         User     @relation(fields: [userId], references: [id])

  @@unique([userId, targetMonth])
  @@map("monthly_goals")
}
